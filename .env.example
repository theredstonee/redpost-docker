# RedPost — Einstellungen fuer docker compose. install.sh legt die .env selbst an; diese Datei zeigt alle Werte.
# Nach einer Aenderung:  docker compose up -d

# Pflicht: Passwort der Datenbank (beim ersten Start festgelegt — spaeter nicht mehr aendern)
DB_PASSWORD=

# Weg nach aussen (eins von beiden):
#   eigener Caddy auf Port 80/443 mit automatischem HTTPS
COMPOSE_FILE=docker-compose.yml:compose.caddy.yml
#   hinter deinem nginx/Apache: nur ein Port auf 127.0.0.1
# COMPOSE_FILE=docker-compose.yml:compose.port.yml
# RP_PORT=8080
# RP_BIND=127.0.0.1
# RP_PROXY_DOMAIN=post.deinefirma.de

# Sprache bis zur Einrichtung (de|en)
RP_LANG=de
TZ=Europe/Berlin

# Eigener Mailserver — setzt der Update-Dienst, wenn du ihn im Panel einschaltest (dann steht compose.mail.yml in COMPOSE_FILE)
# RP_MAIL_HOST=mail.deinefirma.de
# RP_MAIL_POSTMASTER=postmaster@deinefirma.de
# RP_MAIL_CLAMAV=0
# RP_MAIL_SELBSTSIGNIERT=1
# nur fuer Tests: Mail-Ports nicht nach aussen
# RP_MAIL_BIND=127.0.0.1

# Cloudflare Tunnel — setzt der Update-Dienst (Panel → Einstellungen → Installation)
# COMPOSE_PROFILES=tunnel
# RP_TUNNEL_TOKEN=

# Notausgang bei verlorener Zwei-Faktor-Anmeldung (Benutzername eintragen, Neustart, danach wieder leeren)
# RP_RESET_2FA=
